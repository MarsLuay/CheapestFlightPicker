{
  "name": "cheapest-flight-picker",
  "version": "0.2.9",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsup",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "cli": "tsx src/cli/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "commander": "^15.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "path-to-regexp": "8.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.3",
    "tsup": "^8.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.1"
  },
  "description": "Flight search app that compares flexible date windows and surfaces the cheapest options."
}
