[Desktop Entry]
Type=Application
Name=Cheapest Flight Picker
Comment=Set up and launch Cheapest Flight Picker
Terminal=true
Exec=bash -c 'launcher_file="${1#file://}"; launcher_dir="$(CDPATH= cd "$(dirname "$launcher_file")" && pwd)"; run_script() { [ -f "$1" ] || return 1; exec bash "$1"; }; run_script "$launcher_dir/setup-and-launch.sh" || run_script "$launcher_dir/setup-and-launch.app/Contents/Resources/setup-and-launch.sh" || run_script "$launcher_dir/setup-and-launch.app/Contents/MacOS/setup-and-launch" || { repo_dir="$launcher_dir/CheapestFlightPicker"; cloned_script="$repo_dir/setup-and-launch.sh"; if [ ! -f "$cloned_script" ]; then if ! command -v git >/dev/null 2>&1; then echo "Git is required to download Cheapest Flight Picker automatically."; printf "Press Enter to close..."; read _ || true; exit 1; fi; if [ -e "$repo_dir" ] && [ -n "$(ls -A "$repo_dir" 2>/dev/null || true)" ] && [ ! -d "$repo_dir/.git" ]; then echo "$repo_dir already exists but is not a git clone."; printf "Press Enter to close..."; read _ || true; exit 1; fi; if [ ! -d "$repo_dir/.git" ]; then echo "No local repo was found next to this launcher."; echo "Cloning Cheapest Flight Picker into $repo_dir..."; git clone https://github.com/MarsLuay/CheapestFlightPicker.git "$repo_dir" || { echo "Failed to clone Cheapest Flight Picker."; printf "Press Enter to close..."; read _ || true; exit 1; }; fi; fi; run_script "$cloned_script"; echo "No launcher script was found."; printf "Press Enter to close..."; read _ || true; exit 1; }' dummy %k
Icon=utilities-terminal
Categories=Network;Utility;
StartupNotify=false
