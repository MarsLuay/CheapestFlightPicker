[Desktop Entry]
Type=Application
Name=Cheapest Flight Picker
Comment=Set up and launch Cheapest Flight Picker
Terminal=true
Exec=sh -c "set -eu; pause() { printf \"Press Enter to close...\"; read _ || true; }; run_with_optional_sudo() { if [ \"\\$(id -u 2>/dev/null || echo 1)\" -eq 0 ]; then \"\\$@\"; elif command -v sudo >/dev/null 2>&1; then sudo \"\\$@\"; else \"\\$@\"; fi; }; install_git() { if command -v git >/dev/null 2>&1; then return 0; fi; echo \"Git was not found. Trying to install it...\"; if command -v apt-get >/dev/null 2>&1; then run_with_optional_sudo apt-get update && run_with_optional_sudo apt-get install -y git; elif command -v dnf >/dev/null 2>&1; then run_with_optional_sudo dnf install -y git; elif command -v yum >/dev/null 2>&1; then run_with_optional_sudo yum install -y git; elif command -v pacman >/dev/null 2>&1; then run_with_optional_sudo pacman -Sy --noconfirm git; elif command -v zypper >/dev/null 2>&1; then run_with_optional_sudo zypper --non-interactive install git; elif command -v apk >/dev/null 2>&1; then run_with_optional_sudo apk add git; else echo \"Could not find a supported package manager to install git automatically.\"; echo \"Install git, then run this launcher again.\"; pause; exit 1; fi; if ! command -v git >/dev/null 2>&1; then echo \"git still was not found after the install attempt.\"; pause; exit 1; fi; }; launcher_file=\\${1#file://}; launcher_dir=\\$(CDPATH= cd \"\\$(dirname \"\\$launcher_file\")\" && pwd); repo_url=https://github.com/MarsLuay/CheapestFlightPicker.git; repo_dir=\"\\$launcher_dir\"; standalone_repo_dir=\"\\$launcher_dir/CheapestFlightPicker\"; install_git; if [ ! -d \"\\$repo_dir/.git\" ]; then repo_dir=\"\\$standalone_repo_dir\"; if [ ! -d \"\\$repo_dir/.git\" ]; then if [ -e \"\\$repo_dir\" ] && [ \"\\$(ls -A \"\\$repo_dir\" 2>/dev/null || true)\" ]; then echo \"\\$repo_dir already exists but is not a git clone.\"; echo \"Move or delete that folder, then run this launcher again.\"; pause; exit 1; fi; echo \"No local repo was found next to this launcher.\"; echo \"Cloning Cheapest Flight Picker into \\$repo_dir...\"; git clone \"\\$repo_url\" \"\\$repo_dir\" || { echo \"Failed to clone Cheapest Flight Picker.\"; pause; exit 1; }; fi; fi; if repo_status=\\$(git -C \"\\$repo_dir\" status --porcelain --untracked-files=normal); then if [ -z \"\\$repo_status\" ]; then git -C \"\\$repo_dir\" pull --ff-only origin main || { echo \"Failed to update the repo automatically.\"; pause; exit 1; }; else echo \"Local changes detected. Skipping auto-update so your work stays untouched.\"; fi; else echo \"Could not inspect \\$repo_dir.\"; pause; exit 1; fi; launch_script=\"\\$repo_dir/setup-and-launch.app/Contents/MacOS/setup-and-launch\"; runner_script=\"\\$repo_dir/setup-and-launch.app/Contents/Resources/setup-and-launch.sh\"; if [ ! -f \"\\$launch_script\" ]; then echo \"The launcher was not found at \\$launch_script.\"; pause; exit 1; fi; chmod +x \"\\$launch_script\" \"\\$runner_script\" 2>/dev/null || true; exec \"\\$launch_script\"" launcher %k
Icon=utilities-terminal
Categories=Network;Utility;
StartupNotify=false
