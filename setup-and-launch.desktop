[Desktop Entry]
Type=Application
Name=Cheapest Flight Picker
Comment=Set up and launch Cheapest Flight Picker
Terminal=true
Exec=bash -c "set -eu; launcher_file=${1:-.}; launcher_file=${launcher_file#file://}; launcher_file=${launcher_file//%%20/ }; launcher_file=${launcher_file//%%23/#}; launcher_file=${launcher_file//%%25/%}; launcher_dir=$(CDPATH= cd \"$(dirname \"$launcher_file\")\" && pwd); cd \"$launcher_dir\" || exit 1; if [ -f setup-and-launch.sh ]; then exec bash setup-and-launch.sh; fi; if [ -f setup-and-launch.app/Contents/Resources/setup-and-launch.sh ]; then exec bash setup-and-launch.app/Contents/Resources/setup-and-launch.sh; fi; repo_dir=CheapestFlightPicker; if [ -f \"$repo_dir/setup-and-launch.sh\" ]; then exec bash \"$repo_dir/setup-and-launch.sh\"; fi; if [ -e \"$repo_dir\" ] && [ ! -d \"$repo_dir/.git\" ] && [ -n \"$(ls -A \"$repo_dir\" 2>/dev/null || true)\" ]; then echo \"$repo_dir already exists but is not a git clone.\"; exit 1; fi; if [ ! -d \"$repo_dir/.git\" ] && command -v git >/dev/null 2>&1; then echo \"No local repo was found next to this launcher.\"; echo \"Cloning Cheapest Flight Picker into $repo_dir...\"; git clone https://github.com/MarsLuay/CheapestFlightPicker.git \"$repo_dir\"; fi; if [ -f \"$repo_dir/setup-and-launch.sh\" ]; then exec bash \"$repo_dir/setup-and-launch.sh\"; fi; downloaded_script=.cheapestflightpicker-setup-and-launch.sh; if [ ! -s \"$downloaded_script\" ]; then tmp_script=\"$downloaded_script.tmp.$$\"; if command -v curl >/dev/null 2>&1; then curl --fail --location --silent --show-error https://raw.githubusercontent.com/MarsLuay/CheapestFlightPicker/main/setup-and-launch.sh -o \"$tmp_script\"; elif command -v wget >/dev/null 2>&1; then wget --quiet --output-document=\"$tmp_script\" https://raw.githubusercontent.com/MarsLuay/CheapestFlightPicker/main/setup-and-launch.sh; else echo \"Git, curl, or wget is required to download Cheapest Flight Picker automatically.\"; exit 1; fi; chmod +x \"$tmp_script\"; mv -f \"$tmp_script\" \"$downloaded_script\"; fi; chmod +x \"$downloaded_script\"; exec bash \"$downloaded_script\"" -- %k
Icon=utilities-terminal
Categories=Network;Utility;
StartupNotify=false
